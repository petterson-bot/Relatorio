      <div class="k"><div class="l">Vendas WhatsOficial</div><div class="v g">48</div></div>
      <div class="k"><div class="l">Faturamento WA</div><div class="v y">R$ 51.3K</div></div>
    </div>
    <div class="B"><div class="st">Funil WA da Campanha Meta</div><div class="cc"><canvas id="c14"></canvas></div></div>
  </div>

  <div class="P" id="p-clo">
    <div class="st">Performance dos Closers</div>
    <div class="tw">
        <table id="tblClo">
            <thead>
              <tr>
                <th onclick="sortTable(0, 'tblClo')">Closer</th>
                <th onclick="sortTable(1, 'tblClo')">Vendas</th>
                <th onclick="sortTable(2, 'tblClo')">Receita</th>
              </tr>
            </thead>
            <tbody id="tblBodyClo"></tbody>
        </table>
    </div>
  </div>
</div>

