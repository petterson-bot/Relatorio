<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDA 2026 · PERFORMANCE DASHBOARD</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
    --g: #4caf03; --g2: #3a8a02; --b: #000; --c: #0f0f0f; --c2: #141414;
    --br: #fff; --ci: #777; --la: #ff4444; --bd: #1e1e1e;
    --n: #4AE54A; --r: #FF4444; --y: #FFD700; --b-blue: #5BA8FF;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { background: var(--b); color: var(--br); font-family: "Barlow Condensed", sans-serif; overflow-x: hidden; }
body::before {
    content: ""; position: fixed; inset: 0;
    background: radial-gradient(ellipse 55% 70% at 8% 50%, rgba(76,175,3,.08), transparent 65%);
    pointer-events: none; z-index: 0;
}
.W { max-width: 1600px; margin: 0 auto; padding: 20px; position: relative; z-index: 1; }

/* HEADER */
.hero { padding: 30px 20px; text-align: center; border-bottom: 2px solid var(--g); background: linear-gradient(180deg, #0c0c0c, #000); position: relative; }
.hero h1 { font-family: "Bebas Neue", sans-serif; font-size: clamp(32px, 5vw, 64px); letter-spacing: 4px; color: var(--br); }
.hero h1 span { color: var(--g); }

/* BOTÃO DOWNLOAD */
.btn-download {
    position: absolute; top: 20px; right: 20px;
    background: var(--g); color: var(--b); border: none; padding: 10px 20px;
    font-family: "Bebas Neue", sans-serif; font-size: 16px; cursor: pointer;
    border-radius: 4px; transition: 0.3s; z-index: 10;
}
.btn-download:hover { background: var(--br); transform: scale(1.05); }

/* TABS */
.tabs { display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap; justify-content: center; }
.T { 
    padding: 8px 22px; border-radius: 4px; background: var(--c2); border: 1px solid var(--bd); 
    color: var(--ci); font-family: "Bebas Neue", sans-serif; font-size: 18px; cursor: pointer;
}
.T.on { background: var(--g); color: var(--b); border-color: var(--g); }
.P { display: none; } .P.on { display: block; animation: fadeIn 0.5s ease; }

/* TABELAS */
.tw { background: var(--c2); border: 1px solid var(--bd); border-radius: 8px; overflow: hidden; margin-top: 10px; }
table { width: 100%; border-collapse: collapse; }
th { 
    background: #1a1a1a; color: var(--g); padding: 12px; text-align: left; 
    font-family: "Bebas Neue", sans-serif; font-size: 16px; cursor: pointer;
    border-bottom: 2px solid var(--g);
}
th:hover { background: #252525; }
td { padding: 10px 12px; border-bottom: 1px solid var(--bd); font-size: 15px; font-weight: 600; }

.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 25px; }
.k { background: rgba(76,175,3,0.05); border: 1px solid rgba(76,175,3,0.2); border-radius: 8px; padding: 15px; text-align: center; }
.k .l { font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--g); margin-bottom: 5px; }
.k .v { font-family: "Bebas Neue", sans-serif; font-size: 32px; line-height: 1; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>

<div class="hero">
    <button class="btn-download" onclick="downloadHTML()">📥 Baixar HTML</button>
    <h1>SD<span>A</span> AO VIVO 2026 — PERFORMANCE</h1>
    <div style="color:var(--ci); letter-spacing:2px; font-size:12px">Perry Marketing Integrado · Dash Oficial</div>
</div>

<div class="W">
    <div class="tabs">
        <div class="T on" onclick="go('vis')">Visão Geral</div>
        <div class="T" onclick="go('cam')">Campanhas</div>
        <div class="T" onclick="go('clo')">Closers</div>
    </div>

    <div class="P on" id="p-vis">
        <div class="kpis">
            <div class="k"><div class="l">Investimento Meta</div><div class="v">R$ 250.932</div></div>
            <div class="k"><div class="l">Faturamento Real</div><div class="v" style="color:var(--g)">R$ 478.406</div></div>
            <div class="k"><div class="l">ROAS</div><div class="v" style="color:var(--y)">1.91x</div></div>
            <div class="k"><div class="l">Vendas Totais</div><div class="v">424</div></div>
        </div>
    </div>

    <div class="P" id="p-cam">
        <div style="font-family:'Bebas Neue'; font-size:20px; color:var(--g); margin-bottom:10px">📊 Performance Detalhada (Clique nos títulos para ordenar)</div>
        <div class="tw">
            <table id="mainTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0, 'mainTable')">Campanha</th>
                        <th onclick="sortTable(1, 'mainTable')">Gasto</th>
                        <th onclick="sortTable(2, 'mainTable')">Vendas</th>
                        <th onclick="sortTable(3, 'mainTable')">Receita</th>
                        <th onclick="sortTable(4, 'mainTable')">ROAS</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td>Checkout Quente ABO</td><td>23206</td><td>20</td><td>22747</td><td>0.98</td></tr>
                    <tr><td>Advantage CBO T04</td><td>9926</td><td>8</td><td>8476</td><td>0.85</td></tr>
                    <tr><td>Lista Esp. Quente</td><td>939</td><td>22</td><td>20507</td><td>21.8</td></tr>
                    <tr><td>Frio ABO T03</td><td>14977</td><td>3</td><td>4938</td><td>0.33</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="P" id="p-clo">
        <div class="tw">
            <table id="closerTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0, 'closerTable')">Closer</th>
                        <th onclick="sortTable(1, 'closerTable')">Vendas</th>
                        <th onclick="sortTable(2, 'closerTable')">Faturamento</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Nathalia</td><td>36</td><td>50940</td></tr>
                    <tr><td>Juliana</td><td>35</td><td>43535</td></tr>
                    <tr><td>Jalai</td><td>32</td><td>43001</td></tr>
                    <tr><td>Junior</td><td>34</td><td>41045</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
// FUNÇÃO DE NAVEGAÇÃO
function go(id){
    document.querySelectorAll('.P').forEach(p=>p.classList.remove('on'));
    document.querySelectorAll('.T').forEach(t=>t.classList.remove('on'));
    document.getElementById('p-'+id).classList.add('on');
    event.target.classList.add('on');
}

// FUNÇÃO DE ORDENAÇÃO (MAIOR/MENOR)
function sortTable(n, tableId) {
    var table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
    table = document.getElementById(tableId);
    switching = true;
    dir = "asc";
    while (switching) {
        switching = false;
        rows = table.rows;
        for (i = 1; i < (rows.length - 1); i++) {
            shouldSwitch = false;
            x = rows[i].getElementsByTagName("TD")[n];
            y = rows[i+1].getElementsByTagName("TD")[n];
            
            let valX = isNaN(parseFloat(x.innerHTML)) ? x.innerHTML.toLowerCase() : parseFloat(x.innerHTML);
            let valY = isNaN(parseFloat(y.innerHTML)) ? y.innerHTML.toLowerCase() : parseFloat(y.innerHTML);

            if (dir == "asc") {
                if (valX > valY) { shouldSwitch = true; break; }
            } else if (dir == "desc") {
                if (valX < valY) { shouldSwitch = true; break; }
            }
        }
        if (shouldSwitch) {
            rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
            switching = true;
            switchcount ++;
        } else {
            if (switchcount == 0 && dir == "asc") { dir = "desc"; switching = true; }
        }
    }
}

// FUNÇÃO PARA BAIXAR O HTML
function downloadHTML() {
    const htmlContent = document.documentElement.outerHTML;
    const blob = new Blob([htmlContent], { type: 'text/html' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Relatorio_SDA_2026.html';
    document.body.appendChild(a);
    a.click();
    window.URL.revokeObjectURL(url);
    document.body.removeChild(a);
}
</script>
</body>
</html>
