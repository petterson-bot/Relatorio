<title>SDA 2026 </title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#050A05;--c1:#0B130B;--c2:#111C11;--c3:#182818;--bd:#1A351A;--bd2:#256025;
--n:#4AE54A;--r:#FF4444;--y:#FFD700;--o:#FF8C00;--b:#5BA8FF;--cy:#00E5CC;--p:#B57AFF;--pk:#FF6B9D;
--w:#FFFFFF;--t1:#C8D8C8;--t2:#88A088;--t3:#506850}

body{background:var(--bg);color:var(--w);font-family:'Montserrat', sans-serif;-webkit-font-smoothing:antialiased}

.hero{padding:28px 20px;text-align:center;background:linear-gradient(180deg,#0D1A0D,var(--bg));border-bottom:1px solid var(--bd);position:relative}
.hero h1{font-size:clamp(20px,3vw,32px);font-weight:800;letter-spacing:1px;color:var(--n)}
.hero .s{color:var(--t2);font-size:12px;margin-top:4px;font-weight:600}
.hero .p{color:var(--y);font-weight:700;font-size:13px;margin-top:2px}

.btn-dl {position:absolute; top:20px; right:20px; background:transparent; border:1px solid var(--n); color:var(--n); padding:8px 15px; font-size:10px; font-weight:700; cursor:pointer; border-radius:4px; text-transform:uppercase; transition:0.3s}
.btn-dl:hover {background:var(--n); color:var(--bg)}

.W{max-width:1440px;margin:0 auto;padding:0 14px}
.tabs{display:flex;gap:5px;padding:14px 0;flex-wrap:wrap;justify-content:center}
.T{padding:8px 18px;border-radius:4px;background:var(--c1);border:1px solid var(--bd);color:var(--t2);font-size:12px;font-weight:700;cursor:pointer;transition:.2s;white-space:nowrap;text-transform:uppercase}
.T:hover{border-color:var(--n3);color:var(--w)}.T.on{background:var(--n);color:var(--bg);border-color:var(--n)}
.P{display:none}.P.on{display:block}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:10px;margin:14px 0}
.k{background:var(--c1);border:1px solid var(--bd);border-radius:10px;padding:14px;text-align:center}
.k .l{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:var(--t3);margin-bottom:3px;font-weight:700}
.k .v{font-size:22px;font-weight:800}.k .v.g{color:var(--n)}.k .v.r{color:var(--r)}.k .v.y{color:var(--y)}.k .v.b{color:var(--b)}.k .v.c{color:var(--cy)}.k .v.p{color:var(--p)}.k .v.pk{color:var(--pk)}
.k .ss{font-size:9px;color:var(--t3);margin-top:2px;font-weight:500}

.B{background:var(--c1);border:1px solid var(--bd);border-radius:10px;padding:16px;margin-bottom:14px}
.st{font-size:14px;font-weight:700;color:var(--n);padding-left:10px;border-left:3px solid var(--n);margin-bottom:12px;text-transform:uppercase}
.cc{position:relative;height:320px;width:100%}.cc.lg{height:420px}.cc.xl{height:500px}

.tw{overflow-x:auto; background:var(--c1); border-radius:8px; border:1px solid var(--bd)}
table{width:100%;border-collapse:collapse;font-size:11px}
th{background:var(--c2);color:var(--n);padding:10px 8px;text-align:left;font-weight:700;white-space:nowrap;border-bottom:2px solid var(--bd2);text-transform:uppercase;cursor:pointer}
th:hover{background:var(--c3)}
td{padding:8px 8px;border-bottom:1px solid var(--bd);white-space:nowrap;font-weight:500}
tr:nth-child(even){background:var(--c2)}tr:hover{background:rgba(74,229,74,.05)}

.ins{background:var(--c1);border-radius:0 10px 10px 0;padding:14px 18px;margin-bottom:10px;border-left:4px solid var(--n)}
.ins .it{font-weight:800;font-size:13px;margin-bottom:3px;text-transform:uppercase}
.ins .id{color:var(--t1);font-size:12px;line-height:1.5}

@keyframes fu{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.B,.k,.ins{animation:fu .35s ease both}
</style>
</head>
