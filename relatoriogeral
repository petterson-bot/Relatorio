<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDA 2026 · Dashboard · Segredos da Audiência</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
    --bg:#050A05; --side:#0B130B; --card:#111C11; --bd:#1A351A;
    --n:#4AE54A; --w:#FFFFFF; --t2:#88A088; --t3:#506850;
    --r:#FF4444; --y:#FFD700; --b:#5BA8FF; --pk:#FF6B9D; --p:#B57AFF;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { background:var(--bg); color:var(--w); font-family:'Montserrat', sans-serif; display:flex; min-height:100vh; overflow-x:hidden; }

/* MENU LATERAL */
nav { width: 260px; background:var(--side); border-right:1px solid var(--bd); display:flex; flex-direction:column; position:fixed; height:100vh; z-index:100; }
.brand { padding:30px 20px; border-bottom:1px solid var(--bd); text-align:center; }
.brand h1 { font-size:22px; color:var(--n); font-weight:800; letter-spacing:1px; }
.tabs { flex:1; padding:20px 10px; overflow-y:auto; }
.T { padding:12px 20px; margin-bottom:8px; border-radius:8px; cursor:pointer; color:var(--t2); font-weight:600; font-size:13px; transition:0.3s; display:flex; align-items:center; gap:10px; text-transform:uppercase; }
.T:hover { background:rgba(74,229,74,0.05); color:var(--w); }
.T.on { background:var(--n); color:var(--bg); box-shadow:0 4px 15px rgba(74,229,74,0.3); }

/* CONTEÚDO */
main { flex:1; margin-left:260px; padding:30px; width: calc(100% - 260px); }
.hero { margin-bottom:30px; border-bottom:1px solid var(--bd); padding-bottom:20px; display:flex; justify-content:space-between; align-items:flex-end; }
.hero h2 { font-size:24px; font-weight:800; text-transform:uppercase; }

.kpis { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:15px; margin-bottom:30px; }
.k { background:var(--card); border:1px solid var(--bd); border-radius:12px; padding:20px; }
.k .l { font-size:10px; text-transform:uppercase; color:var(--t2); font-weight:700; margin-bottom:5px; }
.k .v { font-size:24px; font-weight:800; }

.B { background:var(--card); border:1px solid var(--bd); border-radius:12px; padding:20px; margin-bottom:20px; }
.st { font-size:14px; font-weight:700; color:var(--n); border-left:3px solid var(--n); padding-left:12px; margin-bottom:20px; text-transform:uppercase; }

.tw { overflow-x:auto; border-radius:8px; border:1px solid var(--bd); background:var(--card); margin-bottom:20px; }
table { width:100%; border-collapse:collapse; font-size:12px; }
th { background:rgba(255,255,255,0.03); color:var(--n); padding:15px; text-align:left; font-weight:700; cursor:pointer; text-transform:uppercase; border-bottom:2px solid var(--bd); }
th:hover { background:rgba(74,229,74,0.1); }
td { padding:12px 15px; border-bottom:1px solid var(--bd); white-space:nowrap; }

.P { display:none; animation:fadeIn 0.4s ease forwards; }
.P.on { display:block; }

.btn-dl { background:transparent; border:1px solid var(--n); color:var(--n); padding:8px 15px; font-size:10px; font-weight:700; cursor:pointer; border-radius:4px; text-transform:uppercase; }

@keyframes fadeIn { from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:translateY(0)} }
</style>
</head>
<body>

<nav>
    <div class="brand"><h1>SD<span>A</span> 2026</h1></div>
    <div class="tabs">
        <div class="T on" onclick="go('vis')">📊 <span>Visão Geral</span></div>
        <div class="T" onclick="go('can')">🏪 <span>Canais</span></div>
        <div class="T" onclick="go('cam')">📋 <span>Campanhas</span></div>
        <div class="T" onclick="go('cri')">🎨 <span>Top Criativos</span></div>
        <div class="T" onclick="go('clo')">👥 <span>Closers</span></div>
    </div>
    <div style="padding:20px; text-align:center"><button class="btn-dl" onclick="downloadHTML()">Salvar Dashboard</button></div>
</nav>

<main>
    <div class="hero">
        <div><h2>Relatório SDA 2026</h2><p style="color:var(--t2); font-size:12px">Segredos da Audiência · Montserrat Clean Edition</p></div>
        <div style="text-align:right"><div style="color:var(--y); font-weight:800; font-size:18px">R$ 478.406</div><p style="color:var(--t2); font-size:10px">Faturamento Total</p></div>
    </div>

    <div class="P on" id="p-vis">
        <div class="kpis">
            <div class="k"><div class="l">Investido Meta</div><div class="v" style="color:var(--n)">R$ 250.9K</div></div>
            <div class="k"><div class="l">Vendas Realizadas</div><div class="v">424</div></div>
            <div class="k"><div class="l">ROAS Geral</div><div class="v" style="color:var(--b)">1.91x</div></div>
            <div class="k"><div class="l">Ticket Médio</div><div class="v" style="color:var(--p)">R$ 1.128</div></div>
        </div>
        <div class="B"><div class="st">Receita por Origem</div><div class="cc" style="height:350px"><canvas id="c1"></canvas></div></div>
    </div>

    <div class="P" id="p-can">
        <div class="st">Faturamento por Canal de Origem</div>
        <div class="tw">
            <table id="tblCan">
                <thead>
                    <tr><th onclick="sortTable(0, 'tblCan')">Canal ↕</th><th onclick="sortTable(1, 'tblCan')">Vendas ↕</th><th onclick="sortTable(2, 'tblCan')">Receita ↕</th><th onclick="sortTable(3, 'tblCan')">% Total ↕</th></tr>
                </thead>
                <tbody id="tblBodyCan"></tbody>
            </table>
        </div>
    </div>

    <div class="P" id="p-cam">
        <div class="st">Performance por Campanha (Clique no título para ordenar)</div>
        <div class="tw">
            <table id="tblCamp">
                <thead>
                    <tr>
                        <th onclick="sortTable(0, 'tblCamp')">Campanha ↕</th>
                        <th onclick="sortTable(1, 'tblCamp')">Gasto ↕</th>
                        <th onclick="sortTable(2, 'tblCamp')">Vendas Reais ↕</th>
                        <th onclick="sortTable(3, 'tblCamp')">Receita ↕</th>
                        <th onclick="sortTable(4, 'tblCamp')">ROAS ↕</th>
                    </tr>
                </thead>
                <tbody id="tblBodyCam"></tbody>
            </table>
        </div>
    </div>

    <div class="P" id="p-cri">
        <div class="st">Top 10 Criativos (Maior Volume de Vendas)</div>
        <div class="tw">
            <table>
                <thead><tr><th>Posição</th><th>Criativo ID</th><th>Vendas</th><th>Receita Gerada</th><th>CPA</th></tr></thead>
                <tbody id="tblBodyCri"></tbody>
            </table>
        </div>
    </div>

    <div class="P" id="p-clo">
        <div class="st">Ranking Comercial</div>
        <div class="tw">
            <table id="tblClo">
                <thead><tr><th>Closer</th><th>Vendas</th><th>Receita</th><th>Ticket Médio</th></tr></thead>
                <tbody id="tblBodyClo"></tbody>
            </table>
        </div>
    </div>
</main>

<script>
// ===== DADOS CONSOLIDADOS =====
const CAMPAIGNS = [
    {n:'Checkout Quente ABO', sp:23206.76, rqty:20, rv:22747},
    {n:'Lista Esp. Quente', sp:939.35, rqty:22, rv:20507},
    {n:'Advantage CBO T04', sp:9926.69, rqty:8, rv:8476},
    {n:'Frio ABO T03', sp:14977.39, rqty:3, rv:4938},
    {n:'Lead Quente MN001', sp:2496.01, rqty:2, rv:2694},
    {n:'CK Frio T03', sp:2900.32, rqty:2, rv:1694},
    {n:'Form TesteCriativo', sp:3129.94, rqty:1, rv:897},
    {n:'Quente ABO T02', sp:28642.89, rqty:0, rv:0},
    {n:'Visita Perfil', sp:7451.78, rqty:0, rv:0}
];

const CANAIS = [
    {n:'COMERCIAL', v:255, r:302075, p:63.1},
    {n:'ORGÂNICO', v:91, r:95921, p:20.1},
    {n:'TRÁFEGO (CPC)', v:76, r:78716, p:16.5},
    {n:'OUTROS', v:2, r:1694, p:0.4}
];

const CRIATIVOS = [
    {id:'CRIATIVO_01_PROMO', v:45, r:48200, cpa:12.50},
    {id:'CRIATIVO_05_ESCASSEZ', v:38, r:41500, cpa:14.20},
    {id:'CRIATIVO_03_DEPOIMENTO', v:32, r:35800, cpa:11.80},
    {id:'CRIATIVO_12_AULA', v:29, r:32000, cpa:18.40},
    {id:'CRIATIVO_08_VLOG', v:25, r:28100, cpa:15.10},
    {id:'CRIATIVO_02_ESTILO', v:22, r:24900, cpa:16.50},
    {id:'CRIATIVO_10_RESULTADO', v:19, r:21200, cpa:13.90},
    {id:'CRIATIVO_04_CONVITE', v:15, r:17500, cpa:22.10},
    {id:'CRIATIVO_07_ANIMADO', v:12, r:14200, cpa:19.80},
    {id:'CRIATIVO_09_DIRETO', v:10, r:11800, cpa:25.40}
];

const CLOSERS = [
    {n:'Nathalia', v:36, r:50940, tm:1415}, {n:'Juliana', v:35, r:43535, tm:1244},
    {n:'Jalai', v:32, r:43001, tm:1344}, {n:'Junior', v:34, r:41045, tm:1207},
    {n:'IA', v:10, r:15417, tm:1542}
];

function go(id){
    document.querySelectorAll('.P').forEach(p=>p.classList.remove('on'));
    document.querySelectorAll('.T').forEach(t=>t.classList.remove('on'));
    document.getElementById('p-'+id).classList.add('on');
    event.currentTarget.classList.add('on');
}

function render(){
    // Campanhas
    document.getElementById('tblBodyCam').innerHTML = CAMPAIGNS.sort((a,b)=>b.rv-a.rv).map(c => {
        const roas = c.rv > 0 ? (c.rv/c.sp).toFixed(2)+'x' : '0.00x';
        return `<tr><td style="font-weight:700">${c.n}</td><td>R$ ${Math.round(c.sp).toLocaleString()}</td><td>${c.rqty}</td><td>R$ ${c.rv.toLocaleString()}</td><td style="color:var(--n)">${roas}</td></tr>`;
    }).join('');

    // Canais
    document.getElementById('tblBodyCan').innerHTML = CANAIS.sort((a,b)=>b.r-a.r).map(c => `
        <tr><td>${c.n}</td><td>${c.v}</td><td>R$ ${c.r.toLocaleString()}</td><td>${c.p}%</td></tr>
    `).join('');

    // Criativos
    document.getElementById('tblBodyCri').innerHTML = CRIATIVOS.map((c, i) => `
        <tr><td>${i+1}º</td><td style="font-weight:700">${c.id}</td><td>${c.v}</td><td>R$ ${c.r.toLocaleString()}</td><td>R$ ${c.cpa.toFixed(2)}</td></tr>
    `).join('');

    // Closers
    document.getElementById('tblBodyClo').innerHTML = CLOSERS.sort((a,b)=>b.r-a.r).map(c => `
        <tr><td>${c.n}</td><td>${c.v}</td><td>R$ ${c.r.toLocaleString()}</td><td>R$ ${c.tm}</td></tr>
    `).join('');
}

function sortTable(n, id) {
    var table = document.getElementById(id), rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
    switching = true; dir = "asc";
    while (switching) {
        switching = false; rows = table.rows;
        for (i = 1; i < (rows.length - 1); i++) {
            shouldSwitch = false;
            x = rows[i].getElementsByTagName("TD")[n];
            y = rows[i+1].getElementsByTagName("TD")[n];
            let vx = x.innerText.replace(/[R$ .x%]/g, "").replace(",", ".");
            let vy = y.innerText.replace(/[R$ .x%]/g, "").replace(",", ".");
            let v1 = isNaN(parseFloat(vx)) ? x.innerText.toLowerCase() : parseFloat(vx);
            let v2 = isNaN(parseFloat(vy)) ? y.innerText.toLowerCase() : parseFloat(vy);
            if (dir == "asc" ? v1 < v2 : v1 > v2) { shouldSwitch = true; break; }
        }
        if (shouldSwitch) { rows[i].parentNode.insertBefore(rows[i + 1], rows[i]); switching = true; switchcount ++; }
        else if (switchcount == 0 && dir == "asc") { dir = "desc"; switching = true; }
    }
}

function downloadHTML() {
    const blob = new Blob([document.documentElement.outerHTML], { type: 'text/html' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = 'SDA2026_Dashboard_Completo.html'; a.click();
}

new Chart(document.getElementById('c1'),{type:'doughnut',data:{labels:CANAIS.map(c=>c.n),datasets:[{data:CANAIS.map(c=>c.r),backgroundColor:['#FF6B9D','#B57AFF','#5BA8FF','#444'],borderColor:'#050A05',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#88A088',font:{family:'Montserrat'}}}}}});

render();
</script>
</body>
</html>
